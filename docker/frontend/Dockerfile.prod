FROM node:22-alpine AS build
WORKDIR /app
COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci
COPY frontend/ ./
COPY backend/database/catalog.json /backend/database/catalog.json
ARG VITE_API_URL=/api/v1
ARG VITE_SITE_URL=https://paineldecomando.com.br
ARG VITE_COMPANY_NAME
ARG VITE_COMPANY_SHORT_NAME
ARG VITE_COMPANY_LEGAL_NAME
ARG VITE_COMPANY_CNPJ
ARG VITE_COMPANY_PHONE
ARG VITE_COMPANY_WHATSAPP
ARG VITE_COMPANY_WHATSAPP_LABEL
ARG VITE_COMPANY_EMAIL
ARG VITE_COMPANY_ADDRESS
ARG VITE_COMPANY_HOURS
ARG VITE_COMPANY_DELIVERY_NOTICE
ENV VITE_API_URL=$VITE_API_URL VITE_SITE_URL=$VITE_SITE_URL VITE_COMPANY_NAME=$VITE_COMPANY_NAME VITE_COMPANY_SHORT_NAME=$VITE_COMPANY_SHORT_NAME VITE_COMPANY_LEGAL_NAME=$VITE_COMPANY_LEGAL_NAME VITE_COMPANY_CNPJ=$VITE_COMPANY_CNPJ VITE_COMPANY_PHONE=$VITE_COMPANY_PHONE VITE_COMPANY_WHATSAPP=$VITE_COMPANY_WHATSAPP VITE_COMPANY_WHATSAPP_LABEL=$VITE_COMPANY_WHATSAPP_LABEL VITE_COMPANY_EMAIL=$VITE_COMPANY_EMAIL VITE_COMPANY_ADDRESS=$VITE_COMPANY_ADDRESS VITE_COMPANY_HOURS=$VITE_COMPANY_HOURS VITE_COMPANY_DELIVERY_NOTICE=$VITE_COMPANY_DELIVERY_NOTICE
RUN npm run build:prod

FROM nginx:1.27-alpine
COPY docker/frontend/nginx.prod.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist /usr/share/nginx/html
EXPOSE 80
HEALTHCHECK --interval=30s --timeout=3s --retries=3 CMD wget -qO- http://127.0.0.1/healthz || exit 1
