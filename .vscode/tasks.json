{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Painel: Backend + logs",
      "type": "process",
      "command": "powershell.exe",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/scripts/dev-backend.ps1"
      ],
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "focus": false,
        "panel": "dedicated",
        "group": "painel-dev",
        "clear": true,
        "showReuseMessage": true
      },
      "runOptions": {
        "instanceLimit": 1
      }
    },
    {
      "label": "Painel: Frontend + logs",
      "type": "process",
      "command": "powershell.exe",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/scripts/dev-frontend.ps1"
      ],
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "focus": false,
        "panel": "dedicated",
        "group": "painel-dev",
        "clear": true,
        "showReuseMessage": true
      },
      "runOptions": {
        "instanceLimit": 1
      }
    },
    {
      "label": "▶ Iniciar Painel de Comando (com logs)",
      "dependsOn": [
        "Painel: Backend + logs",
        "Painel: Frontend + logs"
      ],
      "dependsOrder": "parallel",
      "problemMatcher": [],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "runOptions": {
        "instanceLimit": 1
      }
    }
  ]
}
